{
  "name": "trailmark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "npm run verify:recordings && npm run verify:evals",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "record:phase2": "node --import tsx scripts/record-analysis.mts",
    "record:notice": "node --import tsx scripts/record-notice.mts",
    "verify:recordings": "node --import tsx scripts/verify-recordings.ts",
    "eval:compare": "node --import tsx scripts/compare-evals.ts",
    "eval:record": "node --import tsx scripts/record-evals.mts",
    "eval:report": "node --import tsx scripts/report-evals.ts",
    "verify:evals": "node --import tsx scripts/verify-evals.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
